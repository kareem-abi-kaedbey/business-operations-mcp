{
  "name": "business-operations-mcp",
  "version": "1.0.0",
  "description": "A lightweight MCP server exposing business operations tools to AI applications.",
  "type": "module",
  "scripts": {
    "server": "tsx src/server.ts",
    "client": "tsx src/client.ts",
    "typecheck": "tsc --noEmit",
    "host": "tsx --env-file=.env src/host.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "mcp",
    "ai",
    "typescript",
    "business-operations"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
